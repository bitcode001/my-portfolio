---
import { Image } from 'astro:assets'
import heroProfileIcon from '../assets/profile-icon-full.png'
import SocialButton from '../components/hero-section/SocialButton.astro'
import '../styles/heroSectionStyle.css'
// import VirtueCard from '../components/hero-section/VirtueCard.astro'
---

<div class="hero-pattern">
	<div class="flex min-h-screen flex-1 flex-col justify-center">
		<div class="flex flex-row max-w-4xl mx-auto">
			<!-- Intro Image -->
			<Image
				src={heroProfileIcon}
				class={'relative z-10 w-64'}
				alt={'Hero content subject image'}
			/>

			<!-- Intro Card -->
			<div class="flex flex-col ml-10">
				<div class="flex flex-row items-center justify-center py-2 md:justify-start">
