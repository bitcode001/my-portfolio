					<span class="font-extrabold md:text-4xl lg:text-4xl xl:text-4xl mr-2">Hey, I am</span>

					<span class="font-extrabold text-primary md:text-4xl lg:text-4xl xl:text-4xl">Anil Rai</span>
				</div>


				<span class="py-1 text-center font-extrabold md:text-left md:text-4xl lg:text-4xl xl:text-4xl">
					A <span class="text-primary">Software Engineer</span>
				</span>

				<span class="mt-4">
					Building scalable apps with Full‑Stack & DevOps magic
				</span>
				<span>
					⚡ React • Node.js • TypeScript | 🐳 Docker • Kubernetes • CI/CD
				</span>

				<!-- Contact and Download CV -->
				<div class="flex flex-row content-center mt-12">
					<a
						href="/anil-cv.pdf"
						download
						class="flex self-center mr-8 rounded-md border-2 border-primary px-8 py-2 text-sm font-normal text-primary md:self-baseline md:text-sm lg:text-sm xl:text-md"
					>
						Download CV
					</a>

					<div
						class="flex flex-row justify-center gap-4"
					>
						<SocialButton
							socialLink="https://www.linkedin.com/in/anilrai01/"
							socialLinkLabel="LinkedIn URL"
						>
